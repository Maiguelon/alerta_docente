{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alerta-docente",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alerta-docente",
      "database_id": "a4827ff7-f824-46d4-b811-30ff9938a988",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "vars": {
    "EMAIL_PROVIDER": "disabled",
    "MONITOR_ENABLED": "true",
  },
}
