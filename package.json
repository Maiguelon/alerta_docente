{
  "name": "alerta-docente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "status": "node scripts/admin.mjs status",
    "scan": "node scripts/admin.mjs run",
    "test:email": "node scripts/admin.mjs test-email",
    "secrets:upload": "node scripts/upload-secrets.mjs",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
